# Copy outside the repository; replace placeholders with your Access application values.
CF_ACCESS_TEAM=REPLACE_WITH_ZERO_TRUST_TEAM_NAME
CF_ACCESS_AUD=REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE
# Required HTTPS origin, no path; must match the Access application and tunnel hostname.
TEAM_PUBLIC_ORIGIN=https://comfy.example.com
# Comma-separated exact emails/domains; empty lists deny everyone.
# Explicit emails and exact domains are ORed. Domain rules do not include subdomains.
# Example only: TEAM_ALLOWED_EMAILS=alice@example.com,bob@example.com
# Example only: TEAM_ALLOWED_DOMAINS=example.org
TEAM_ALLOWED_EMAILS=
TEAM_ALLOWED_DOMAINS=
# Keep both services on loopback; never tunnel directly to the backend.
TEAM_BACKEND_URL=http://127.0.0.1:8188
TEAM_GATEWAY_HOST=127.0.0.1
TEAM_GATEWAY_PORT=8189
# If backend storage differs from checkout defaults, set matching absolute paths:
# TEAM_INPUT_DIR=/path/to/ComfyUI/input
# TEAM_OUTPUT_DIR=/path/to/ComfyUI/output
# TEAM_TEMP_DIR=/path/to/ComfyUI/temp
